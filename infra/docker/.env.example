# Compose-level variables (read by docker-compose.yml, not by the app itself).
# Copy to infra/docker/.env and fill in real values before running:
#   cp infra/docker/.env.example infra/docker/.env
#
# App secrets (JWT, OAuth, news API keys) live in server/.env — see server/.env.example.

DB_NAME=news_aggregator
DB_USER=news_aggregator_user
DB_PASSWORD=change_this_db_password
DB_ROOT_PASSWORD=change_this_root_password

# Port the client/nginx container is published on
HTTP_PORT=80

# Baked into the client build; use /api when nginx proxies same-origin (default)
VITE_API_URL=/api
